
@{
    ViewData["Title"] = "線上簽名";
}

<div class="container mt-5" style="max-width:700px">
    <h2 class="text-center mb-4">線上簽名系統</h2>

    <div class="mb-3">
        <label class="form-label">簽名者姓名</label>
        <input type="text" id="name" class="form-control"
               placeholder="請輸入姓名">
    </div>

    <label class="form-label">請在下方簽名</label>

    <canvas id="signatureCanvas"
            style="width:100%; height:250px;
                   border:1px solid #ccc;
                   border-radius:8px;
                   touch-action:none;">
    </canvas>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-secondary"
                onclick="clearSignature()">
            清除重簽
        </button>

        <button class="btn btn-primary"
                onclick="saveSignature()">
            送出簽名
        </button>
    </div>

    <div id="result" class="mt-3"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/signature_pad@5.0.4/dist/signature_pad.umd.min.js"></script>

<script>
    const canvas = document.getElementById("signatureCanvas");

    function resizeCanvas() {
        const ratio = Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = canvas.offsetWidth * ratio;
        canvas.height = 250 * ratio;
        canvas.getContext("2d").scale(ratio, ratio);
    }

    resizeCanvas();

    const signaturePad = new SignaturePad(canvas);

    function clearSignature() {
        signaturePad.clear();
        document.getElementById("result").innerHTML = "";
    }

    async function saveSignature() {
        const name = document.getElementById("name").value.trim();
        const result = document.getElementById("result");

        if (!name) {
            alert("請輸入姓名");
            return;
        }

        if (signaturePad.isEmpty()) {
            alert("請先簽名");
            return;
        }

        const formData = new FormData();
        formData.append("name", name);
        formData.append("signature", signaturePad.toDataURL("image/png"));

        // ASP.NET Core Anti-forgery Token
        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]'
        ).value;

        formData.append("__RequestVerificationToken", token);

        try {
            const response = await fetch("/Home/Save", {
                method: "POST",
                body: formData
            });

            if (!response.ok) {
                const error = await response.text();
                throw new Error(error);
            }

            const data = await response.json();

            result.innerHTML =
                `<div class="alert alert-success">${data.message}</div>`;

            signaturePad.off();
        }
        catch (error) {
            alert("儲存失敗：" + error.message);
        }
    }
</script>

<form style="display:none">
    @Html.AntiForgeryToken()
</form>
